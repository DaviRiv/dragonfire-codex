# Copilot ranks locally. ChatGPT: copy the prompt, or set OPENAI_API_KEY on the
# server so signed-in users can use Ask ChatGPT (never put this in the browser).
OPENAI_API_KEY=
# Optional model (default gpt-4o-mini)
OPENAI_MODEL=
# Optional. If unset, the server writes a secret to data/.auth-secret.
AUTH_SECRET=
# Google sign-in (server only). In Google Cloud, add redirect URI
# https://<your-app-host>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Default is ./data
DRAGONFIRE_DATA=

# Ads — AdSense (recommended) or Google Ad Manager (GPT). Leave blank for house ads.
# On Cursor hosting, set the ADSENSE_* names in app secrets (not NEXT_PUBLIC_*).
# AdSense: after site approval, create display units for each placement below.
ADSENSE_CLIENT=
ADSENSE_SLOT_BILLBOARD=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_SIDEBAR_LOWER=
ADSENSE_SLOT_FEED=
ADSENSE_SLOT_ANCHOR=
# Optional Ad Manager path prefix (enables gpt.js instead of AdSense)
GPT_AD_UNIT=
# Local dev may still use legacy NEXT_PUBLIC_* copies of the same values.
