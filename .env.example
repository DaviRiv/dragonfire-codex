# No API keys. Copilot ranks locally; ChatGPT copy is paste-only.
# Optional. If unset, the server writes a secret to data/.auth-secret.
AUTH_SECRET=
# Optional. Default is ./data
DRAGONFIRE_DATA=

# Ads — Wowhead-style Google Publisher Tag (GAM) or AdSense.
# Leave blank to show house ads in the same slots (leaderboard, sidebar, mobile banner).
# GPT example: /12345678/dragonfire  (slots append /billboard, /sidebar, …)
NEXT_PUBLIC_GPT_AD_UNIT=
# AdSense
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_BILLBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_LOWER=
NEXT_PUBLIC_ADSENSE_SLOT_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_ANCHOR=
